{
  "name": "glyphfox",
  "version": "1.2.0",
  "description": "Variable, morphable and fusable open source icons on a 24 grid, with React, Vue, Svelte, Solid, Preact, Qwik, Lit, Astro, React Native, Ember, web component, Tailwind and CLI.",
  "license": "MIT",
  "author": "Alexandre Kohler (https://github.com/kwy404)",
  "homepage": "https://kwy404.github.io/glyphfox/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kwy404/glyphfox.git",
    "directory": "packages/glyphfox"
  },
  "bugs": "https://github.com/kwy404/glyphfox/issues",
  "keywords": [
    "icons",
    "svg",
    "icon-library",
    "variable-icons",
    "morph",
    "react",
    "vue",
    "svelte",
    "web-components",
    "tailwindcss",
    "solid",
    "preact",
    "qwik",
    "lit",
    "astro",
    "react-native",
    "ember"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/web/index.js",
    "./dist/web/glyphfox.min.js",
    "./dist/runtime/auto.js",
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/web/glyphfox.min.js",
  "jsdelivr": "./dist/web/glyphfox.min.js",
  "bin": {
    "glyphfox": "./bin/glyphfox.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@qwik.dev/core": ">=2.0.0-0",
    "astro": ">=4.0.0",
    "ember-source": ">=4.5.0",
    "lit": "^3.0.0",
    "preact": ">=10.11.0",
    "react": ">=16.8",
    "react-native": ">=0.72.0",
    "react-native-svg": ">=13.0.0",
    "solid-js": ">=1.8.0",
    "svelte": "^5.0.0",
    "tailwindcss": ">=3.0.0",
    "vue": "^3.2.0"
  },
  "peerDependenciesMeta": {
    "@qwik.dev/core": {
      "optional": true
    },
    "astro": {
      "optional": true
    },
    "ember-source": {
      "optional": true
    },
    "lit": {
      "optional": true
    },
    "preact": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./icons/*": {
      "types": "./dist/icons/*.d.ts",
      "default": "./dist/icons/*.js"
    },
    "./icons.json": "./dist/icons.json",
    "./collections": {
      "types": "./dist/collections.d.ts",
      "default": "./dist/collections.js"
    },
    "./sprite.svg": "./dist/sprite.svg",
    "./styles.css": "./dist/styles.css",
    "./runtime": {
      "types": "./dist/runtime/auto.d.ts",
      "default": "./dist/runtime/auto.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    },
    "./script": {
      "types": "./dist/script/index.d.ts",
      "default": "./dist/script/index.js"
    },
    "./export": {
      "types": "./dist/export/index.d.ts",
      "default": "./dist/export/index.js"
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./react/icons/*": {
      "types": "./dist/react/icons/*.d.ts",
      "default": "./dist/react/icons/*.js"
    },
    "./react/server": {
      "types": "./dist/react/server.d.ts",
      "default": "./dist/react/server.js"
    },
    "./react/collections": {
      "types": "./dist/react/collections.d.ts",
      "default": "./dist/react/collections.js"
    },
    "./vue": {
      "import": {
        "types": "./dist/vue/index.d.ts",
        "default": "./dist/vue/index.js"
      },
      "require": {
        "types": "./dist/vue/index.d.cts",
        "default": "./dist/vue/index.cjs"
      }
    },
    "./vue/icons/*": {
      "types": "./dist/vue/icons/*.d.ts",
      "default": "./dist/vue/icons/*.js"
    },
    "./vue/collections": {
      "types": "./dist/vue/collections.d.ts",
      "default": "./dist/vue/collections.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "default": "./dist/svelte/index.js"
    },
    "./svelte/icons/*": {
      "types": "./dist/svelte/icons/*.svelte.d.ts",
      "svelte": "./dist/svelte/icons/*.svelte",
      "default": "./dist/svelte/icons/*.svelte"
    },
    "./svelte/collections": {
      "types": "./dist/svelte/collections.d.ts",
      "svelte": "./dist/svelte/collections.js",
      "default": "./dist/svelte/collections.js"
    },
    "./solid": {
      "types": "./dist/solid/index.d.ts",
      "default": "./dist/solid/index.js"
    },
    "./solid/icons/*": {
      "types": "./dist/solid/icons/*.d.ts",
      "default": "./dist/solid/icons/*.js"
    },
    "./preact": {
      "types": "./dist/preact/index.d.ts",
      "default": "./dist/preact/index.js"
    },
    "./preact/icons/*": {
      "types": "./dist/preact/icons/*.d.ts",
      "default": "./dist/preact/icons/*.js"
    },
    "./qwik": {
      "types": "./dist/qwik/index.d.ts",
      "default": "./dist/qwik/index.js"
    },
    "./qwik/icons/*": {
      "types": "./dist/qwik/icons/*.d.ts",
      "default": "./dist/qwik/icons/*.js"
    },
    "./lit": {
      "types": "./dist/lit/index.d.ts",
      "default": "./dist/lit/index.js"
    },
    "./lit/icons/*": {
      "types": "./dist/lit/icons/*.d.ts",
      "default": "./dist/lit/icons/*.js"
    },
    "./astro": {
      "types": "./dist/astro/index.d.ts",
      "default": "./dist/astro/index.js"
    },
    "./astro/icons/*": "./dist/astro/icons/*.astro",
    "./native": {
      "types": "./dist/native/index.d.ts",
      "default": "./dist/native/index.js"
    },
    "./native/icons/*": {
      "types": "./dist/native/icons/*.d.ts",
      "default": "./dist/native/icons/*.js"
    },
    "./ember": {
      "types": "./dist/ember/index.d.ts",
      "default": "./dist/ember/index.js"
    },
    "./ember/icons/*": {
      "types": "./dist/ember/icons/*.d.ts",
      "default": "./dist/ember/icons/*.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    },
    "./web/element": {
      "types": "./dist/web/element.d.ts",
      "default": "./dist/web/element.js"
    },
    "./web/cdn": "./dist/web/glyphfox.min.js",
    "./tailwind": {
      "import": {
        "types": "./dist/tailwind/index.d.ts",
        "default": "./dist/tailwind/index.js"
      },
      "require": {
        "types": "./dist/tailwind/index.d.cts",
        "default": "./dist/tailwind/index.cjs"
      }
    },
    "./package.json": "./package.json"
  }
}
