{
  "categories": [
    "travel"
  ],
  "tags": [
    "world tour",
    "globe",
    "around the world",
    "trip",
    "journey"
  ],
  "animation": {
    "name": "orbit",
    "duration": 1200,
    "easing": "ease-in-out",
    "loop": false,
    "origin": [12, 13],
    "frames": [
      { "at": 0, "element": 3, "props": { "transform": "rotate(0deg)" } },
      { "at": 0.5, "element": 3, "props": { "transform": "rotate(30deg)" } },
      { "at": 1, "element": 3, "props": { "transform": "rotate(0deg)" } },
      { "at": 0, "element": 4, "props": { "transform": "rotate(0deg)" } },
      { "at": 0.5, "element": 4, "props": { "transform": "rotate(30deg)" } },
      { "at": 1, "element": 4, "props": { "transform": "rotate(0deg)" } }
    ]
  }
}
