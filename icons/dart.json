      { "at": 0, "element": 4, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0.35, "element": 4, "props": { "transform": "translate(-1px, 1px)" } },
      { "at": 0.65, "element": 4, "props": { "transform": "translate(0.15px, -0.15px)" } },
