      { "at": 0.12, "element": 0, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0.428, "element": 0, "props": { "transform": "translate(-1.5px, 0px)" } },
      { "at": 0.692, "element": 0, "props": { "transform": "translate(0.22px, 0px)" } },
