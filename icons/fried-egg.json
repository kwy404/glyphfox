{
  "categories": [
    "food"
  ],
  "tags": [
    "egg",
    "fried egg",
    "breakfast",
    "sunny side up"
  ],
  "animation": {
    "name": "wobble",
    "duration": 900,
    "easing": "ease-in-out",
    "loop": false,
    "origin": [11.5, 12],
    "frames": [
      { "at": 0, "element": 1, "props": { "transform": "scale(1)" } },
      { "at": 0.3, "element": 1, "props": { "transform": "scale(1.12)" } },
      { "at": 0.5, "element": 1, "props": { "transform": "scale(0.95)" } },
      { "at": 0.7, "element": 1, "props": { "transform": "scale(1.04)" } },
      { "at": 1, "element": 1, "props": { "transform": "scale(1)" } }
    ]
  }
}
