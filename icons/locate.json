{
  "categories": [
    "maps",
    "navigation"
  ],
  "tags": [
    "crosshair",
    "gps",
    "my location",
    "target"
  ],
  "animation": {
    "name": "turn",
    "duration": 900,
    "easing": "ease-in-out",
    "loop": false,
    "frames": [
      { "at": 0, "element": "all", "props": { "transform": "rotate(0deg)" } },
      { "at": 1, "element": "all", "props": { "transform": "rotate(90deg)" } }
    ]
  }
}
