{
  "categories": [
    "gaming"
  ],
  "tags": [
    "defense",
    "guild",
    "emblem",
    "heraldry",
    "rpg"
  ],
  "animation": {
    "name": "twinkle",
    "duration": 900,
    "easing": "ease-in-out",
    "loop": false,
    "origin": [12, 14.5],
    "frames": [
      { "at": 0, "element": 2, "props": { "transform": "rotate(0deg) scale(1)" } },
      { "at": 0.3, "element": 2, "props": { "transform": "rotate(20deg) scale(0.85)" } },
      { "at": 0.65, "element": 2, "props": { "transform": "rotate(-10deg) scale(1.1)" } },
      { "at": 1, "element": 2, "props": { "transform": "rotate(0deg) scale(1)" } }
    ]
  }
}
