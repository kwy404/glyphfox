{
  "categories": [
    "data"
  ],
  "tags": [
    "graph",
    "share",
    "proportion",
    "analytics"
  ],
  "animation": {
    "name": "separate",
    "duration": 900,
    "easing": "ease-in-out",
    "loop": false,
    "frames": [
      { "at": 0, "element": 1, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0.35, "element": 1, "props": { "transform": "translate(1px, -1px)" } },
      { "at": 0.6, "element": 1, "props": { "transform": "translate(1px, -1px)" } },
      { "at": 1, "element": 1, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0, "element": "secondary", "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0.35, "element": "secondary", "props": { "transform": "translate(1px, -1px)" } },
      { "at": 0.6, "element": "secondary", "props": { "transform": "translate(1px, -1px)" } },
      { "at": 1, "element": "secondary", "props": { "transform": "translate(0px, 0px)" } }
    ]
  }
}
