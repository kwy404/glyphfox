      { "at": 0.2, "element": 0, "props": { "opacity": 0.3 } },
      { "at": 0.4, "element": 0, "props": { "opacity": 1 } },
      { "at": 1, "element": 0, "props": { "opacity": 1 } },
      { "at": 0, "element": 1, "props": { "opacity": 1 } },
      { "at": 0.3, "element": 1, "props": { "opacity": 1 } },
      { "at": 0.5, "element": 1, "props": { "opacity": 0.3 } },
      { "at": 0.7, "element": 1, "props": { "opacity": 1 } },
      { "at": 1, "element": 1, "props": { "opacity": 1 } }
    ]
