{
  "categories": [
    "food"
  ],
  "tags": [
    "strawberry",
    "berry",
    "fruit",
    "sweet",
    "summer"
  ],
  "animation": {
    "name": "wiggle",
    "duration": 800,
    "easing": "ease-in-out",
    "loop": false,
    "origin": [12, 21],
    "frames": [
      { "at": 0, "element": "all", "props": { "transform": "rotate(0deg)" } },
      { "at": 0.12, "element": "all", "props": { "transform": "rotate(-6deg)" } },
      { "at": 0.27, "element": "all", "props": { "transform": "rotate(6deg)" } },
      { "at": 0.42, "element": "all", "props": { "transform": "rotate(-4.2deg)" } },
      { "at": 0.57, "element": "all", "props": { "transform": "rotate(3deg)" } },
      { "at": 0.72, "element": "all", "props": { "transform": "rotate(-1.5deg)" } },
      { "at": 0.86, "element": "all", "props": { "transform": "rotate(0.6deg)" } },
      { "at": 1, "element": "all", "props": { "transform": "rotate(0deg)" } }
    ]
  }
}
