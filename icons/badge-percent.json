{
  "categories": [
    "commerce",
    "finance"
  ],
  "tags": [
    "discount",
    "sale",
    "offer",
    "deal"
  ],
  "animation": {
    "name": "turn",
    "duration": 1000,
    "easing": "ease-in-out",
    "loop": false,
    "frames": [
      { "at": 0, "element": 0, "props": { "transform": "rotate(0deg)" } },
      { "at": 1, "element": 0, "props": { "transform": "rotate(45deg)" } },
      { "at": 0, "element": 1, "props": { "transform": "scale(1)" } },
      { "at": 0.3, "element": 1, "props": { "transform": "scale(0.85)" } },
      { "at": 0.6, "element": 1, "props": { "transform": "scale(1.1)" } },
      { "at": 1, "element": 1, "props": { "transform": "scale(1)" } },
      { "at": 0, "element": 2, "props": { "transform": "scale(1)" } },
      { "at": 0.3, "element": 2, "props": { "transform": "scale(0.85)" } },
      { "at": 0.6, "element": 2, "props": { "transform": "scale(1.1)" } },
      { "at": 1, "element": 2, "props": { "transform": "scale(1)" } },
      { "at": 0, "element": 3, "props": { "transform": "scale(1)" } },
      { "at": 0.3, "element": 3, "props": { "transform": "scale(0.85)" } },
      { "at": 0.6, "element": 3, "props": { "transform": "scale(1.1)" } },
      { "at": 1, "element": 3, "props": { "transform": "scale(1)" } }
    ]
  }
}
