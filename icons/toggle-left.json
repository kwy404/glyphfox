{
  "categories": [
    "interface"
  ],
  "tags": [
    "switch",
    "off",
    "disabled",
    "setting"
  ],
  "animation": {
    "name": "switch",
    "duration": 900,
    "easing": "ease-in-out",
    "loop": false,
    "frames": [
      { "at": 0, "element": 1, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0.35, "element": 1, "props": { "transform": "translate(6px, 0px)" } },
      { "at": 0.6, "element": 1, "props": { "transform": "translate(6px, 0px)" } },
      { "at": 1, "element": 1, "props": { "transform": "translate(0px, 0px)" } }
    ]
  }
}
