{
  "categories": [
    "weather"
  ],
  "tags": [
    "fog",
    "mist",
    "haze",
    "forecast"
  ],
  "animation": {
    "name": "drift",
    "duration": 1400,
    "easing": "ease-in-out",
    "loop": false,
    "frames": [
      { "at": 0, "element": 1, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0.4, "element": 1, "props": { "transform": "translate(1.5px, 0px)" } },
      { "at": 0.8, "element": 1, "props": { "transform": "translate(-0.5px, 0px)" } },
      { "at": 1, "element": 1, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0, "element": 2, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0.4, "element": 2, "props": { "transform": "translate(-1.5px, 0px)" } },
      { "at": 0.8, "element": 2, "props": { "transform": "translate(0.5px, 0px)" } },
      { "at": 1, "element": 2, "props": { "transform": "translate(0px, 0px)" } }
    ]
  }
}
