{
  "categories": [
    "development"
  ],
  "tags": [
    "version control",
    "commit",
    "node",
    "history"
  ],
  "animation": {
    "name": "pop",
    "duration": 600,
    "easing": "ease-in-out",
    "loop": false,
    "frames": [
      { "at": 0, "element": 0, "props": { "transform": "scale(1)" } },
      { "at": 0.3, "element": 0, "props": { "transform": "scale(0.8)" } },
      { "at": 0.6, "element": 0, "props": { "transform": "scale(1.2)" } },
      { "at": 1, "element": 0, "props": { "transform": "scale(1)" } }
    ]
  }
}
