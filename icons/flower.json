  ],
  "animation": {
    "name": "sway",
    "duration": 1400,
    "easing": "ease-in-out",
    "loop": false,
    "frames": [
      { "at": 0, "element": "all", "props": { "transform": "translate(0px, 10px) rotate(0deg) translate(0px, -10px)" } },
      { "at": 0.3, "element": "all", "props": { "transform": "translate(0px, 10px) rotate(-6deg) translate(0px, -10px)" } },
      { "at": 0.65, "element": "all", "props": { "transform": "translate(0px, 10px) rotate(3.6deg) translate(0px, -10px)" } },
      { "at": 1, "element": "all", "props": { "transform": "translate(0px, 10px) rotate(0deg) translate(0px, -10px)" } },
      { "at": 0, "element": 0, "props": { "transform": "translate(0px, -2.5px) rotate(0deg) translate(0px, 2.5px)" } },
      { "at": 1, "element": 0, "props": { "transform": "translate(0px, -2.5px) rotate(72deg) translate(0px, 2.5px)" } }
    ]
  }
