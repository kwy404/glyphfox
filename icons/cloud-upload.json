{
  "categories": [
    "files",
    "weather"
  ],
  "tags": [
    "upload",
    "sync",
    "backup",
    "storage"
  ],
  "animation": {
    "name": "nudge",
    "duration": 700,
    "easing": "ease-in-out",
    "loop": false,
    "frames": [
      { "at": 0, "element": 1, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0.35, "element": 1, "props": { "transform": "translate(0px, -1px)" } },
      { "at": 0.65, "element": 1, "props": { "transform": "translate(0px, 0.15px)" } },
      { "at": 1, "element": 1, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0, "element": 2, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0.35, "element": 2, "props": { "transform": "translate(0px, -1px)" } },
      { "at": 0.65, "element": 2, "props": { "transform": "translate(0px, 0.15px)" } },
      { "at": 1, "element": 2, "props": { "transform": "translate(0px, 0px)" } }
    ]
  }
}
