{
  "categories": [
    "maps",
    "navigation"
  ],
  "tags": [
    "location",
    "place",
    "marker",
    "address",
    "gps"
  ],
  "animation": {
    "name": "drop",
    "duration": 1000,
    "easing": "ease-in-out",
    "loop": false,
    "origin": [12, 22],
    "frames": [
      { "at": 0, "element": 0, "props": { "transform": "translate(0px, 0px)" }, "easing": "ease-out" },
      { "at": 0.3, "element": 0, "props": { "transform": "translate(0px, -1px)" }, "easing": "ease-in" },
      { "at": 0.55, "element": 0, "props": { "transform": "translate(0px, 0px)" }, "easing": "ease-out" },
      { "at": 0.7, "element": 0, "props": { "transform": "translate(0px, -0.3px)" }, "easing": "ease-in" },
      { "at": 0.85, "element": 0, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 1, "element": 0, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0, "element": 1, "props": { "transform": "translate(0px, 0px)" }, "easing": "ease-out" },
      { "at": 0.3, "element": 1, "props": { "transform": "translate(0px, -1px)" }, "easing": "ease-in" },
      { "at": 0.55, "element": 1, "props": { "transform": "translate(0px, 0px)" }, "easing": "ease-out" },
      { "at": 0.7, "element": 1, "props": { "transform": "translate(0px, -0.3px)" }, "easing": "ease-in" },
      { "at": 0.85, "element": 1, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 1, "element": 1, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0, "element": 2, "props": { "transform": "scale(1, 1)" } },
      { "at": 0.3, "element": 2, "props": { "transform": "scale(0.7, 1)" } },
      { "at": 0.55, "element": 2, "props": { "transform": "scale(1.1, 1)" } },
      { "at": 0.75, "element": 2, "props": { "transform": "scale(1, 1)" } },
      { "at": 1, "element": 2, "props": { "transform": "scale(1, 1)" } },
      { "at": 0, "element": "secondary", "props": { "transform": "translate(0px, 0px)" }, "easing": "ease-out" },
      { "at": 0.3, "element": "secondary", "props": { "transform": "translate(0px, -1px)" }, "easing": "ease-in" },
      { "at": 0.55, "element": "secondary", "props": { "transform": "translate(0px, 0px)" }, "easing": "ease-out" },
      { "at": 0.7, "element": "secondary", "props": { "transform": "translate(0px, -0.3px)" }, "easing": "ease-in" },
      { "at": 0.85, "element": "secondary", "props": { "transform": "translate(0px, 0px)" } },
      { "at": 1, "element": "secondary", "props": { "transform": "translate(0px, 0px)" } }
    ]
  }
