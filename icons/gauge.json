{
  "categories": [
    "data"
  ],
  "tags": [
    "speed",
    "meter",
    "dashboard",
    "performance"
  ],
  "animation": {
    "name": "sweep",
    "duration": 1100,
    "easing": "ease-in-out",
    "loop": false,
    "origin": [12, 14],
    "frames": [
      { "at": 0, "element": 1, "props": { "transform": "rotate(0deg)" } },
      { "at": 0.35, "element": 1, "props": { "transform": "rotate(-80deg)" } },
      { "at": 0.7, "element": 1, "props": { "transform": "rotate(15deg)" } },
      { "at": 1, "element": 1, "props": { "transform": "rotate(0deg)" } }
    ]
  }
}
