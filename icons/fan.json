{
  "categories": [
    "devices",
    "weather"
  ],
  "tags": [
    "cooling",
    "air",
    "ventilator",
    "breeze",
    "appliance"
  ],
  "animation": {
    "name": "spin",
    "duration": 1000,
    "easing": "ease-in-out",
    "loop": false,
    "origin": [12, 10],
    "frames": [
      { "at": 0, "element": 1, "props": { "transform": "rotate(0deg)" } },
      { "at": 1, "element": 1, "props": { "transform": "rotate(360deg)" } },
      { "at": 0, "element": 2, "props": { "transform": "rotate(0deg)" } },
      { "at": 1, "element": 2, "props": { "transform": "rotate(360deg)" } }
    ]
  }
}
