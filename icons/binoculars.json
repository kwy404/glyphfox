{
  "categories": [
    "travel"
  ],
  "tags": [
    "binoculars",
    "explore",
    "view",
    "birdwatching",
    "sightseeing"
  ],
  "animation": {
    "name": "look",
    "duration": 1200,
    "easing": "ease-in-out",
    "loop": false,
    "frames": [
      { "at": 0, "element": "all", "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0.3, "element": "all", "props": { "transform": "translate(-1px, 0px)" } },
      { "at": 0.7, "element": "all", "props": { "transform": "translate(1px, 0px)" } },
      { "at": 1, "element": "all", "props": { "transform": "translate(0px, 0px)" } }
    ]
  }
}
