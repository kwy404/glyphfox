{
  "categories": [
    "interface"
  ],
  "tags": [
    "loading",
    "spinner",
    "progress",
    "busy"
  ],
  "animation": {
    "name": "spin",
    "duration": 800,
    "easing": "linear",
    "loop": true,
    "frames": [
      { "at": 0, "element": "all", "props": { "transform": "rotate(0deg)" } },
      { "at": 1, "element": "all", "props": { "transform": "rotate(360deg)" } }
    ]
  }
}
