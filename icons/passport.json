{
  "categories": [
    "travel"
  ],
  "tags": [
    "passport",
    "id",
    "travel document",
    "border",
    "visa"
  ],
  "animation": {
    "name": "pop",
    "duration": 600,
    "easing": "ease-in-out",
    "loop": false,
    "origin": [12, 10],
    "frames": [
      { "at": 0, "element": 1, "props": { "transform": "scale(1)" } },
      { "at": 0.3, "element": 1, "props": { "transform": "scale(0.85)" } },
      { "at": 0.6, "element": 1, "props": { "transform": "scale(1.15)" } },
      { "at": 1, "element": 1, "props": { "transform": "scale(1)" } },
      { "at": 0, "element": 2, "props": { "transform": "scale(1)" } },
      { "at": 0.3, "element": 2, "props": { "transform": "scale(0.85)" } },
      { "at": 0.6, "element": 2, "props": { "transform": "scale(1.15)" } },
      { "at": 1, "element": 2, "props": { "transform": "scale(1)" } }
    ]
  }
}
