{
  "categories": [
    "nature"
  ],
  "tags": [
    "forest",
    "park",
    "nature",
    "plant",
    "wood"
  ],
  "animation": {
    "name": "sway",
    "duration": 1400,
    "easing": "ease-in-out",
    "loop": false,
    "origin": [12, 22],
    "frames": [
      { "at": 0, "element": "all", "props": { "transform": "rotate(0deg)" } },
      { "at": 0.3, "element": "all", "props": { "transform": "rotate(-3deg)" } },
      { "at": 0.65, "element": "all", "props": { "transform": "rotate(1.8deg)" } },
      { "at": 1, "element": "all", "props": { "transform": "rotate(0deg)" } }
    ]
  }
}
