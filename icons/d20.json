{
  "categories": [
    "gaming"
  ],
  "tags": [
    "dice",
    "roleplay",
    "rpg",
    "tabletop",
    "roll"
  ],
  "animation": {
    "name": "roll",
    "duration": 1000,
    "easing": "ease-in-out",
    "loop": false,
    "frames": [
      { "at": 0, "element": "all", "props": { "transform": "rotate(0deg) scale(1)" } },
      { "at": 0.5, "element": "all", "props": { "transform": "rotate(60deg) scale(0.92)" } },
      { "at": 1, "element": "all", "props": { "transform": "rotate(120deg) scale(1)" } }
    ]
  }
}
