{
  "categories": [
    "interface"
  ],
  "tags": [
    "stopwatch",
    "countdown",
    "time",
    "measure"
  ],
  "animation": {
    "name": "turn",
    "duration": 1000,
    "easing": "ease-in-out",
    "loop": false,
    "origin": [12, 14],
    "frames": [
      { "at": 0, "element": 3, "props": { "transform": "rotate(0deg)" } },
      { "at": 1, "element": 3, "props": { "transform": "rotate(360deg)" } }
    ]
  }
}
