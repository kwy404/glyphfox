{
  "categories": [
    "interface",
    "files"
  ],
  "tags": [
    "upload",
    "progress",
    "sending",
    "transfer"
  ],
  "animation": {
    "duration": 2000,
    "iterations": "infinite",
    "easing": "ease-in-out",
    "elements": [
      {
        "index": 1,
        "keyframes": [
          { "offset": 0, "opacity": 0, "translate": [0, 2] },
          { "offset": 0.25, "opacity": 1, "translate": [0, 0] },
          { "offset": 0.75, "opacity": 1, "translate": [0, -1] },
          { "offset": 1, "opacity": 0, "translate": [0, -1] }
        ]
      },
      {
        "index": 2,
        "keyframes": [
          { "offset": 0, "opacity": 0, "translate": [0, 2] },
          { "offset": 0.25, "opacity": 1, "translate": [0, 0] },
          { "offset": 0.75, "opacity": 1, "translate": [0, -1] },
          { "offset": 1, "opacity": 0, "translate": [0, -1] }
        ]
      },
      {
        "index": 3,
        "keyframes": [
          { "offset": 0, "opacity": 1, "draw": 0 },
          { "offset": 0.8, "opacity": 1, "draw": 1 },
          { "offset": 0.9, "opacity": 1, "draw": 1 },
          { "offset": 1, "opacity": 0, "draw": 1 }
        ]
      }
    ]
  }
}
