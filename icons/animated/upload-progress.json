{
  "categories": [
    "interface",
    "files"
  ],
  "tags": [
    "upload",
    "progress",
    "sending",
    "transfer"
  ],
  "animation": {
    "name": "upload-progress",
    "duration": 2000,
    "easing": "ease-in-out",
    "loop": true,
    "frames": [
      { "at": 0, "element": 1, "props": { "transform": "translate(0px, 2px)", "opacity": 0 } },
      { "at": 0.25, "element": 1, "props": { "transform": "translate(0px, 0px)", "opacity": 1 } },
      { "at": 0.75, "element": 1, "props": { "transform": "translate(0px, -1px)", "opacity": 1 } },
      { "at": 1, "element": 1, "props": { "transform": "translate(0px, -1px)", "opacity": 0 } },
      { "at": 0, "element": 2, "props": { "transform": "translate(0px, 2px)", "opacity": 0 } },
      { "at": 0.25, "element": 2, "props": { "transform": "translate(0px, 0px)", "opacity": 1 } },
      { "at": 0.75, "element": 2, "props": { "transform": "translate(0px, -1px)", "opacity": 1 } },
      { "at": 1, "element": 2, "props": { "transform": "translate(0px, -1px)", "opacity": 0 } },
      { "at": 0, "element": 3, "props": { "opacity": 1, "strokeDashoffset": 1 } },
      { "at": 0.8, "element": 3, "props": { "opacity": 1, "strokeDashoffset": 0 } },
      { "at": 0.9, "element": 3, "props": { "opacity": 1, "strokeDashoffset": 0 } },
      { "at": 1, "element": 3, "props": { "opacity": 0, "strokeDashoffset": 0 } }
    ]
  }
}
