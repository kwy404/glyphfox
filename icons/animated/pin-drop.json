{
  "categories": [
    "maps"
  ],
  "tags": [
    "location",
    "pin",
    "place",
    "marker",
    "drop"
  ],
  "animation": {
    "name": "pin-drop",
    "duration": 2000,
    "easing": "ease-in-out",
    "loop": true,
    "origin": [12, 21],
    "frames": [
      { "at": 0, "element": 0, "props": { "transform": "translate(0px, -2.5px)", "opacity": 0 }, "easing": "ease-in" },
      { "at": 0.3, "element": 0, "props": { "transform": "translate(0px, 0px)", "opacity": 1 }, "easing": "ease-in" },
      { "at": 0.38, "element": 0, "props": { "transform": "translate(0px, -1px)" }, "easing": "ease-in" },
      { "at": 0.46, "element": 0, "props": { "transform": "translate(0px, 0px)" }, "easing": "ease-in" },
      { "at": 0.85, "element": 0, "props": { "transform": "translate(0px, 0px)", "opacity": 1 }, "easing": "ease-in" },
      { "at": 1, "element": 0, "props": { "transform": "translate(0px, 0px)", "opacity": 0 }, "easing": "ease-in" },
      { "at": 0, "element": 1, "props": { "transform": "translate(0px, -2.5px)", "opacity": 0 }, "easing": "ease-in" },
      { "at": 0.3, "element": 1, "props": { "transform": "translate(0px, 0px)", "opacity": 1 }, "easing": "ease-in" },
      { "at": 0.38, "element": 1, "props": { "transform": "translate(0px, -1px)" }, "easing": "ease-in" },
      { "at": 0.46, "element": 1, "props": { "transform": "translate(0px, 0px)" }, "easing": "ease-in" },
      { "at": 0.85, "element": 1, "props": { "transform": "translate(0px, 0px)", "opacity": 1 }, "easing": "ease-in" },
      { "at": 1, "element": 1, "props": { "transform": "translate(0px, 0px)", "opacity": 0 }, "easing": "ease-in" },
      { "at": 0, "element": 2, "props": { "transform": "scale(0.4, 1)" } },
      { "at": 0.3, "element": 2, "props": { "transform": "scale(1, 1)" } },
      { "at": 0.85, "element": 2, "props": { "transform": "scale(1, 1)" } },
      { "at": 1, "element": 2, "props": { "transform": "scale(0.4, 1)" } }
    ]
  }
}
