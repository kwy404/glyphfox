{
  "categories": [
    "devices",
    "communication"
  ],
  "tags": [
    "wifi",
    "wireless",
    "signal",
    "connecting"
  ],
  "animation": {
    "name": "wifi-pulse",
    "duration": 1600,
    "easing": "ease-in-out",
    "loop": true,
    "frames": [
      { "at": 0, "element": 1, "props": { "opacity": 0.2 } },
      { "at": 0.2, "element": 1, "props": { "opacity": 1 } },
      { "at": 0.75, "element": 1, "props": { "opacity": 1 } },
      { "at": 1, "element": 1, "props": { "opacity": 0.2 } },
      { "at": 0, "element": 2, "props": { "opacity": 0.2 } },
      { "at": 0.2, "element": 2, "props": { "opacity": 0.2 } },
      { "at": 0.4, "element": 2, "props": { "opacity": 1 } },
      { "at": 0.75, "element": 2, "props": { "opacity": 1 } },
      { "at": 1, "element": 2, "props": { "opacity": 0.2 } },
      { "at": 0, "element": 3, "props": { "opacity": 0.2 } },
      { "at": 0.4, "element": 3, "props": { "opacity": 0.2 } },
      { "at": 0.6, "element": 3, "props": { "opacity": 1 } },
      { "at": 0.75, "element": 3, "props": { "opacity": 1 } },
      { "at": 1, "element": 3, "props": { "opacity": 0.2 } }
    ]
  }
}
