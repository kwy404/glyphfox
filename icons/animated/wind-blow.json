{
  "categories": [
    "weather"
  ],
  "tags": [
    "wind",
    "breeze",
    "air",
    "blowing"
  ],
  "animation": {
    "duration": 2000,
    "iterations": "infinite",
    "easing": "ease-in-out",
    "elements": [
      {
        "index": 0,
        "delay": 0,
        "keyframes": [
          { "offset": 0, "opacity": 0, "translate": [-1.5, 0] },
          { "offset": 0.3, "opacity": 1, "translate": [0, 0] },
          { "offset": 0.7, "opacity": 1, "translate": [0.5, 0] },
          { "offset": 1, "opacity": 0, "translate": [1.5, 0] }
        ]
      },
      {
        "index": 1,
        "delay": 200,
        "keyframes": [
          { "offset": 0, "opacity": 0, "translate": [-1.5, 0] },
          { "offset": 0.3, "opacity": 1, "translate": [0, 0] },
          { "offset": 0.7, "opacity": 1, "translate": [0.5, 0] },
          { "offset": 1, "opacity": 0, "translate": [1.5, 0] }
        ]
      },
      {
        "index": 2,
        "delay": 400,
        "keyframes": [
          { "offset": 0, "opacity": 0, "translate": [-1.5, 0] },
          { "offset": 0.3, "opacity": 1, "translate": [0, 0] },
          { "offset": 0.7, "opacity": 1, "translate": [0.5, 0] },
          { "offset": 1, "opacity": 0, "translate": [1.5, 0] }
        ]
      }
    ]
  }
}
