{
  "categories": [
    "media"
  ],
  "tags": [
    "music",
    "playing",
    "song",
    "audio",
    "notes"
  ],
  "animation": {
    "name": "music-bounce",
    "duration": 1200,
    "easing": "ease-in-out",
    "loop": true,
    "frames": [
      { "at": 0, "element": 0, "props": { "transform": "translate(0px, 0px) rotate(0deg)" } },
      { "at": 0.25, "element": 0, "props": { "transform": "translate(0px, -1px) rotate(-4deg)" } },
      { "at": 0.5, "element": 0, "props": { "transform": "translate(0px, 0px) rotate(0deg)" } },
      { "at": 0.75, "element": 0, "props": { "transform": "translate(0px, -0.6px) rotate(4deg)" } },
      { "at": 1, "element": 0, "props": { "transform": "translate(0px, 0px) rotate(0deg)" } },
      { "at": 0, "element": 1, "props": { "transform": "translate(0px, 0px) rotate(0deg)" } },
      { "at": 0.25, "element": 1, "props": { "transform": "translate(0px, -1px) rotate(-4deg)" } },
      { "at": 0.5, "element": 1, "props": { "transform": "translate(0px, 0px) rotate(0deg)" } },
      { "at": 0.75, "element": 1, "props": { "transform": "translate(0px, -0.6px) rotate(4deg)" } },
      { "at": 1, "element": 1, "props": { "transform": "translate(0px, 0px) rotate(0deg)" } },
      { "at": 0, "element": 2, "props": { "transform": "translate(0px, 0px) rotate(0deg)" } },
      { "at": 0.25, "element": 2, "props": { "transform": "translate(0px, -1px) rotate(-4deg)" } },
      { "at": 0.5, "element": 2, "props": { "transform": "translate(0px, 0px) rotate(0deg)" } },
      { "at": 0.75, "element": 2, "props": { "transform": "translate(0px, -0.6px) rotate(4deg)" } },
      { "at": 1, "element": 2, "props": { "transform": "translate(0px, 0px) rotate(0deg)" } }
    ]
  }
}
