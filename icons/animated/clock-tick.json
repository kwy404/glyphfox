{
  "categories": [
    "interface"
  ],
  "tags": [
    "time",
    "clock",
    "hours",
    "schedule"
  ],
  "animation": {
    "name": "clock-tick",
    "duration": 4000,
    "easing": "ease-in-out",
    "loop": true,
    "frames": [
      { "at": 0, "element": 1, "props": { "transform": "rotate(0deg)" }, "easing": "linear" },
      { "at": 1, "element": 1, "props": { "transform": "rotate(360deg)" }, "easing": "linear" },
      { "at": 0, "element": 2, "props": { "transform": "rotate(0deg)" }, "easing": "linear" },
      { "at": 1, "element": 2, "props": { "transform": "rotate(30deg)" }, "easing": "linear" }
    ]
  }
}
