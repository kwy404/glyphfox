{
  "categories": [
    "interface"
  ],
  "tags": [
    "time",
    "clock",
    "hours",
    "schedule"
  ],
  "animation": {
    "duration": 4000,
    "iterations": "infinite",
    "easing": "ease-in-out",
    "elements": [
      {
        "index": 1,
        "origin": [12, 12],
        "easing": "linear",
        "keyframes": [
          { "offset": 0, "rotate": 0 },
          { "offset": 1, "rotate": 360 }
        ]
      },
      {
        "index": 2,
        "origin": [12, 12],
        "easing": "linear",
        "keyframes": [
          { "offset": 0, "rotate": 0 },
          { "offset": 1, "rotate": 30 }
        ]
      }
    ]
  }
}
