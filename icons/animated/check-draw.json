    "frames": [
      { "at": 0, "element": 0, "props": { "opacity": 1, "strokeDashoffset": 1 } },
      { "at": 0.4, "element": 0, "props": { "opacity": 1, "strokeDashoffset": 0 } },
      { "at": 0.9, "element": 0, "props": { "opacity": 1, "strokeDashoffset": 0 } },
      { "at": 1, "element": 0, "props": { "opacity": 0, "strokeDashoffset": 0 } },
      { "at": 0, "element": 1, "props": { "opacity": 1, "strokeDashoffset": 1 } },
      { "at": 0.45, "element": 1, "props": { "opacity": 1, "strokeDashoffset": 1 } },
      { "at": 0.7, "element": 1, "props": { "opacity": 1, "strokeDashoffset": 0 } },
      { "at": 0.9, "element": 1, "props": { "opacity": 1, "strokeDashoffset": 0 } },
      { "at": 1, "element": 1, "props": { "opacity": 0, "strokeDashoffset": 0 } }
