{
  "categories": [
    "interface"
  ],
  "tags": [
    "switch",
    "toggle",
    "on",
    "off",
    "setting"
  ],
  "animation": {
    "name": "toggle-slide",
    "duration": 1800,
    "easing": "ease-in-out",
    "loop": true,
    "frames": [
      { "at": 0, "element": 1, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0.35, "element": 1, "props": { "transform": "translate(6px, 0px)" } },
      { "at": 0.65, "element": 1, "props": { "transform": "translate(6px, 0px)" } },
      { "at": 1, "element": 1, "props": { "transform": "translate(0px, 0px)" } }
    ]
  }
}
