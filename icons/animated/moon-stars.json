{
  "categories": [
    "weather"
  ],
  "tags": [
    "moon",
    "night",
    "stars",
    "sleep",
    "dark"
  ],
  "animation": {
    "name": "moon-stars",
    "duration": 2400,
    "easing": "ease-in-out",
    "loop": true,
    "origin": [17, 7],
    "frames": [
      { "at": 0, "element": 1, "props": { "transform": "scale(0.6)" } },
      { "at": 0.5, "element": 1, "props": { "transform": "scale(1.15)" } },
      { "at": 1, "element": 1, "props": { "transform": "scale(0.6)" } },
      { "at": 0, "element": 2, "props": { "opacity": 1 } },
      { "at": 0.5, "element": 2, "props": { "opacity": 0.2 } },
      { "at": 1, "element": 2, "props": { "opacity": 1 } }
    ]
  }
}
