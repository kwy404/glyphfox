{
  "categories": [
    "interface",
    "communication"
  ],
  "tags": [
    "notification",
    "ring",
    "alert",
    "alarm"
  ],
  "animation": {
    "name": "bell-swing",
    "duration": 1600,
    "easing": "ease-in-out",
    "loop": true,
    "origin": [12, 3],
    "frames": [
      { "at": 0, "element": 0, "props": { "transform": "rotate(0deg)" } },
      { "at": 0.1, "element": 0, "props": { "transform": "rotate(12deg)" } },
      { "at": 0.2, "element": 0, "props": { "transform": "rotate(-10deg)" } },
      { "at": 0.3, "element": 0, "props": { "transform": "rotate(7deg)" } },
      { "at": 0.4, "element": 0, "props": { "transform": "rotate(-4deg)" } },
      { "at": 0.5, "element": 0, "props": { "transform": "rotate(2deg)" } },
      { "at": 0.6, "element": 0, "props": { "transform": "rotate(0deg)" } },
      { "at": 1, "element": 0, "props": { "transform": "rotate(0deg)" } },
      { "at": 0, "element": 1, "props": { "transform": "rotate(0deg)" } },
      { "at": 0.038, "element": 1, "props": { "transform": "rotate(0deg)" } },
      { "at": 0.138, "element": 1, "props": { "transform": "rotate(16deg)" } },
      { "at": 0.238, "element": 1, "props": { "transform": "rotate(-14deg)" } },
      { "at": 0.337, "element": 1, "props": { "transform": "rotate(9deg)" } },
      { "at": 0.438, "element": 1, "props": { "transform": "rotate(-5deg)" } },
      { "at": 0.538, "element": 1, "props": { "transform": "rotate(2deg)" } },
      { "at": 0.638, "element": 1, "props": { "transform": "rotate(0deg)" } },
      { "at": 1, "element": 1, "props": { "transform": "rotate(0deg)" } }
    ]
  }
}
