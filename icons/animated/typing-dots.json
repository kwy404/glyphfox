{
  "categories": [
    "communication"
  ],
  "tags": [
    "typing",
    "chat",
    "writing",
    "message"
  ],
  "animation": {
    "name": "typing-dots",
    "duration": 1200,
    "easing": "ease-in-out",
    "loop": true,
    "frames": [
      { "at": 0, "element": 1, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0.2, "element": 1, "props": { "transform": "translate(0px, -2px)" } },
      { "at": 0.4, "element": 1, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 1, "element": 1, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0, "element": 2, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0.125, "element": 2, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0.325, "element": 2, "props": { "transform": "translate(0px, -2px)" } },
      { "at": 0.525, "element": 2, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 1, "element": 2, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0, "element": 3, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0.25, "element": 3, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0.45, "element": 3, "props": { "transform": "translate(0px, -2px)" } },
      { "at": 0.65, "element": 3, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 1, "element": 3, "props": { "transform": "translate(0px, 0px)" } }
    ]
  }
}
