{
  "categories": [
    "interface",
    "communication"
  ],
  "tags": [
    "notification",
    "unread",
    "badge",
    "new"
  ],
  "animation": {
    "name": "notification-badge",
    "duration": 2000,
    "easing": "ease-in-out",
    "loop": true,
    "origin": [18.5, 5.5],
    "frames": [
      { "at": 0, "element": 2, "props": { "transform": "scale(0)" } },
      { "at": 0.2, "element": 2, "props": { "transform": "scale(1.25)" } },
      { "at": 0.3, "element": 2, "props": { "transform": "scale(1)" } },
      { "at": 0.85, "element": 2, "props": { "transform": "scale(1)" } },
      { "at": 1, "element": 2, "props": { "transform": "scale(0)" } }
    ]
  }
}
