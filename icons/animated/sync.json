{
  "categories": [
    "arrows",
    "interface"
  ],
  "tags": [
    "refresh",
    "syncing",
    "reload",
    "update"
  ],
  "animation": {
    "name": "sync",
    "duration": 1400,
    "easing": "ease-in-out",
    "loop": true,
    "frames": [
      { "at": 0, "element": 0, "props": { "transform": "rotate(0deg)" }, "easing": "linear" },
      { "at": 1, "element": 0, "props": { "transform": "rotate(360deg)" }, "easing": "linear" },
      { "at": 0, "element": 1, "props": { "transform": "rotate(0deg)" }, "easing": "linear" },
      { "at": 1, "element": 1, "props": { "transform": "rotate(360deg)" }, "easing": "linear" },
      { "at": 0, "element": 2, "props": { "transform": "rotate(0deg)" }, "easing": "linear" },
      { "at": 1, "element": 2, "props": { "transform": "rotate(360deg)" }, "easing": "linear" },
      { "at": 0, "element": 3, "props": { "transform": "rotate(0deg)" }, "easing": "linear" },
      { "at": 1, "element": 3, "props": { "transform": "rotate(360deg)" }, "easing": "linear" }
    ]
  }
}
