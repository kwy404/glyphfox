{
  "categories": [
    "interface",
    "data"
  ],
  "tags": [
    "progress",
    "loading",
    "bar",
    "percent"
  ],
  "animation": {
    "duration": 2000,
    "iterations": "infinite",
    "easing": "ease-in-out",
    "elements": [
      {
        "index": 1,
        "keyframes": [
          { "offset": 0, "opacity": 1, "draw": 0 },
          { "offset": 0.8, "opacity": 1, "draw": 1 },
          { "offset": 0.9, "opacity": 1, "draw": 1 },
          { "offset": 1, "opacity": 0, "draw": 1 }
        ]
      }
    ]
  }
}
