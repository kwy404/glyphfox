{
  "categories": [
    "interface",
    "data"
  ],
  "tags": [
    "progress",
    "loading",
    "bar",
    "percent"
  ],
  "animation": {
    "name": "progress-bar",
    "duration": 2000,
    "easing": "ease-in-out",
    "loop": true,
    "frames": [
      { "at": 0, "element": 1, "props": { "opacity": 1, "strokeDashoffset": 1 } },
      { "at": 0.8, "element": 1, "props": { "opacity": 1, "strokeDashoffset": 0 } },
      { "at": 0.9, "element": 1, "props": { "opacity": 1, "strokeDashoffset": 0 } },
      { "at": 1, "element": 1, "props": { "opacity": 0, "strokeDashoffset": 0 } }
    ]
  }
}
