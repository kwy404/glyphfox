{
  "categories": [
    "media"
  ],
  "tags": [
    "sound",
    "audio",
    "volume",
    "speaker",
    "playing"
  ],
  "animation": {
    "name": "volume-waves",
    "duration": 1400,
    "easing": "ease-in-out",
    "loop": true,
    "frames": [
      { "at": 0, "element": 1, "props": { "opacity": 0.2 } },
      { "at": 0.25, "element": 1, "props": { "opacity": 1 } },
      { "at": 0.75, "element": 1, "props": { "opacity": 1 } },
      { "at": 1, "element": 1, "props": { "opacity": 0.2 } },
      { "at": 0, "element": 2, "props": { "opacity": 0.2 } },
      { "at": 0.25, "element": 2, "props": { "opacity": 0.2 } },
      { "at": 0.5, "element": 2, "props": { "opacity": 1 } },
      { "at": 0.75, "element": 2, "props": { "opacity": 1 } },
      { "at": 1, "element": 2, "props": { "opacity": 0.2 } }
    ]
  }
}
