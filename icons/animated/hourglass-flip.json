{
  "categories": [
    "interface"
  ],
  "tags": [
    "time",
    "wait",
    "loading",
    "sand"
  ],
  "animation": {
    "name": "hourglass-flip",
    "duration": 2400,
    "easing": "ease-in-out",
    "loop": true,
    "frames": [
      { "at": 0, "element": 0, "props": { "transform": "rotate(0deg)" } },
      { "at": 0.75, "element": 0, "props": { "transform": "rotate(0deg)" } },
      { "at": 0.95, "element": 0, "props": { "transform": "rotate(180deg)" } },
      { "at": 1, "element": 0, "props": { "transform": "rotate(180deg)" } },
      { "at": 0, "element": 1, "props": { "transform": "rotate(0deg)" } },
      { "at": 0.75, "element": 1, "props": { "transform": "rotate(0deg)" } },
      { "at": 0.95, "element": 1, "props": { "transform": "rotate(180deg)" } },
      { "at": 1, "element": 1, "props": { "transform": "rotate(180deg)" } },
      { "at": 0, "element": 2, "props": { "transform": "rotate(0deg)" } },
      { "at": 0.75, "element": 2, "props": { "transform": "rotate(0deg)" } },
      { "at": 0.95, "element": 2, "props": { "transform": "rotate(180deg)" } },
      { "at": 1, "element": 2, "props": { "transform": "rotate(180deg)" } },
      { "at": 0, "element": 3, "props": { "transform": "rotate(0deg)" } },
      { "at": 0.75, "element": 3, "props": { "transform": "rotate(0deg)" } },
      { "at": 0.95, "element": 3, "props": { "transform": "rotate(180deg)" } },
      { "at": 1, "element": 3, "props": { "transform": "rotate(180deg)" } },
      { "at": 0, "element": 4, "props": { "opacity": 0.2 } },
      { "at": 0.7, "element": 4, "props": { "opacity": 1 } },
      { "at": 0.75, "element": 4, "props": { "opacity": 0 } },
      { "at": 1, "element": 4, "props": { "opacity": 0 } }
    ]
  }
}
