{
  "categories": [
    "nature"
  ],
  "tags": [
    "fire",
    "flame",
    "hot",
    "burn",
    "trending"
  ],
  "animation": {
    "name": "fire-flicker",
    "duration": 900,
    "easing": "ease-in-out",
    "loop": true,
    "origin": [12, 22],
    "frames": [
      { "at": 0, "element": 0, "props": { "transform": "rotate(0deg) scale(1, 1)" } },
      { "at": 0.3, "element": 0, "props": { "transform": "rotate(-2deg) scale(0.97, 1.04)" } },
      { "at": 0.6, "element": 0, "props": { "transform": "rotate(1.5deg) scale(1.02, 0.98)" } },
      { "at": 1, "element": 0, "props": { "transform": "rotate(0deg) scale(1, 1)" } }
    ]
  }
}
