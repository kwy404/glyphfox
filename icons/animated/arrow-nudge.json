  "animation": {
    "name": "arrow-nudge",
    "duration": 1400,
    "easing": "ease-in-out",
    "loop": true,
    "frames": [
      { "at": 0, "element": 0, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0.3, "element": 0, "props": { "transform": "translate(2px, 0px)" } },
      { "at": 0.6, "element": 0, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 1, "element": 0, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0, "element": 1, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0.3, "element": 1, "props": { "transform": "translate(2px, 0px)" } },
      { "at": 0.6, "element": 1, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 1, "element": 1, "props": { "transform": "translate(0px, 0px)" } }
    ]
  }
