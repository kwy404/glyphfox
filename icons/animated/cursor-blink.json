{
  "categories": [
    "text"
  ],
  "tags": [
    "cursor",
    "typing",
    "text",
    "caret",
    "input"
  ],
  "animation": {
    "name": "cursor-blink",
    "duration": 1000,
    "easing": "ease-in-out",
    "loop": true,
    "frames": [
      { "at": 0, "element": 0, "props": { "opacity": 1 }, "easing": "steps(1, end)" },
      { "at": 0.5, "element": 0, "props": { "opacity": 0 }, "easing": "steps(1, end)" },
      { "at": 1, "element": 0, "props": { "opacity": 0 } },
      { "at": 0, "element": 1, "props": { "opacity": 1 }, "easing": "steps(1, end)" },
      { "at": 0.5, "element": 1, "props": { "opacity": 0 }, "easing": "steps(1, end)" },
      { "at": 1, "element": 1, "props": { "opacity": 0 } },
      { "at": 0, "element": 2, "props": { "opacity": 1 }, "easing": "steps(1, end)" },
      { "at": 0.5, "element": 2, "props": { "opacity": 0 }, "easing": "steps(1, end)" },
      { "at": 1, "element": 2, "props": { "opacity": 0 } }
    ]
  }
}
