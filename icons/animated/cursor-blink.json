{
  "categories": [
    "text"
  ],
  "tags": [
    "cursor",
    "typing",
    "text",
    "caret",
    "input"
  ],
  "animation": {
    "duration": 1000,
    "iterations": "infinite",
    "easing": "ease-in-out",
    "elements": [
      {
        "index": 0,
        "keyframes": [
          { "offset": 0, "opacity": 1, "easing": "steps(1, end)" },
          { "offset": 0.5, "opacity": 0, "easing": "steps(1, end)" },
          { "offset": 1, "opacity": 0 }
        ]
      },
      {
        "index": 1,
        "keyframes": [
          { "offset": 0, "opacity": 1, "easing": "steps(1, end)" },
          { "offset": 0.5, "opacity": 0, "easing": "steps(1, end)" },
          { "offset": 1, "opacity": 0 }
        ]
      },
      {
        "index": 2,
        "keyframes": [
          { "offset": 0, "opacity": 1, "easing": "steps(1, end)" },
          { "offset": 0.5, "opacity": 0, "easing": "steps(1, end)" },
          { "offset": 1, "opacity": 0 }
        ]
      }
    ]
  }
}
