{
  "categories": [
    "interface",
    "security"
  ],
  "tags": [
    "eye",
    "blink",
    "view",
    "look"
  ],
  "animation": {
    "name": "eye-blink",
    "duration": 3000,
    "easing": "ease-in-out",
    "loop": true,
    "frames": [
      { "at": 0, "element": 0, "props": { "transform": "scale(1, 1)" } },
      { "at": 0.42, "element": 0, "props": { "transform": "scale(1, 1)" } },
      { "at": 0.47, "element": 0, "props": { "transform": "scale(1, 0.1)" } },
      { "at": 0.52, "element": 0, "props": { "transform": "scale(1, 1)" } },
      { "at": 1, "element": 0, "props": { "transform": "scale(1, 1)" } },
      { "at": 0, "element": 1, "props": { "transform": "scale(1, 1)" } },
      { "at": 0.42, "element": 1, "props": { "transform": "scale(1, 1)" } },
      { "at": 0.47, "element": 1, "props": { "transform": "scale(1, 0.1)" } },
      { "at": 0.52, "element": 1, "props": { "transform": "scale(1, 1)" } },
      { "at": 1, "element": 1, "props": { "transform": "scale(1, 1)" } }
    ]
  }
}
