        ]
      },
      {
        "index": 1,
        "keyframes": [
          { "offset": 0, "opacity": 0, "translate": [-1.5, 1.5] },
          { "offset": 0.3, "opacity": 1, "translate": [0, 0] },
          { "offset": 0.7, "opacity": 1, "translate": [0, 0] },
          { "offset": 1, "opacity": 0, "translate": [1, -1] }
        ]
      }
    ]
  }
