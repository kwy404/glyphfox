  ],
  "animation": {
    "name": "send-fly",
    "duration": 1800,
    "easing": "ease-in-out",
    "loop": true,
    "frames": [
      { "at": 0, "element": 0, "props": { "transform": "translate(-1.5px, 1.5px)", "opacity": 0 } },
      { "at": 0.3, "element": 0, "props": { "transform": "translate(0px, 0px)", "opacity": 1 } },
      { "at": 0.7, "element": 0, "props": { "transform": "translate(0px, 0px)", "opacity": 1 } },
      { "at": 1, "element": 0, "props": { "transform": "translate(1px, -1px)", "opacity": 0 } },
      { "at": 0, "element": 1, "props": { "transform": "translate(-1.5px, 1.5px)", "opacity": 0 } },
      { "at": 0.3, "element": 1, "props": { "transform": "translate(0px, 0px)", "opacity": 1 } },
      { "at": 0.7, "element": 1, "props": { "transform": "translate(0px, 0px)", "opacity": 1 } },
      { "at": 1, "element": 1, "props": { "transform": "translate(1px, -1px)", "opacity": 0 } }
    ]
  }
