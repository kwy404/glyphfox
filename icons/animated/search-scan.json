{
  "categories": [
    "interface"
  ],
  "tags": [
    "search",
    "find",
    "looking",
    "scanning"
  ],
  "animation": {
    "name": "search-scan",
    "duration": 2000,
    "easing": "ease-in-out",
    "loop": true,
    "frames": [
      { "at": 0, "element": 0, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0.25, "element": 0, "props": { "transform": "translate(1.5px, -1px)" } },
      { "at": 0.5, "element": 0, "props": { "transform": "translate(0px, -1.5px)" } },
      { "at": 0.75, "element": 0, "props": { "transform": "translate(-1.5px, -1px)" } },
      { "at": 1, "element": 0, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0, "element": 1, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0.25, "element": 1, "props": { "transform": "translate(1.5px, -1px)" } },
      { "at": 0.5, "element": 1, "props": { "transform": "translate(0px, -1.5px)" } },
      { "at": 0.75, "element": 1, "props": { "transform": "translate(-1.5px, -1px)" } },
      { "at": 1, "element": 1, "props": { "transform": "translate(0px, 0px)" } }
    ]
  }
}
