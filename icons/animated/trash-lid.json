  "animation": {
    "name": "trash-lid",
    "duration": 1800,
    "easing": "ease-in-out",
    "loop": true,
    "origin": [3, 8],
    "frames": [
      { "at": 0, "element": 1, "props": { "transform": "rotate(0deg)" } },
      { "at": 0.3, "element": 1, "props": { "transform": "rotate(-12deg)" } },
      { "at": 0.6, "element": 1, "props": { "transform": "rotate(-12deg)" } },
      { "at": 0.8, "element": 1, "props": { "transform": "rotate(0deg)" } },
      { "at": 1, "element": 1, "props": { "transform": "rotate(0deg)" } },
      { "at": 0, "element": 2, "props": { "transform": "rotate(0deg)" } },
      { "at": 0.3, "element": 2, "props": { "transform": "rotate(-12deg)" } },
      { "at": 0.6, "element": 2, "props": { "transform": "rotate(-12deg)" } },
      { "at": 0.8, "element": 2, "props": { "transform": "rotate(0deg)" } },
      { "at": 1, "element": 2, "props": { "transform": "rotate(0deg)" } }
    ]
