{
  "categories": [
    "maps",
    "navigation"
  ],
  "tags": [
    "compass",
    "direction",
    "navigate",
    "explore"
  ],
  "animation": {
    "name": "compass-swing",
    "duration": 2400,
    "easing": "ease-in-out",
    "loop": true,
    "frames": [
      { "at": 0, "element": 1, "props": { "transform": "rotate(0deg)" } },
      { "at": 0.15, "element": 1, "props": { "transform": "rotate(40deg)" } },
      { "at": 0.3, "element": 1, "props": { "transform": "rotate(-25deg)" } },
      { "at": 0.45, "element": 1, "props": { "transform": "rotate(15deg)" } },
      { "at": 0.6, "element": 1, "props": { "transform": "rotate(-8deg)" } },
      { "at": 0.75, "element": 1, "props": { "transform": "rotate(4deg)" } },
      { "at": 1, "element": 1, "props": { "transform": "rotate(0deg)" } }
    ]
  }
}
