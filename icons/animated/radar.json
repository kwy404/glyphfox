  "animation": {
    "name": "radar",
    "duration": 2400,
    "easing": "ease-in-out",
    "loop": true,
    "frames": [
      { "at": 0, "element": 2, "props": { "transform": "rotate(0deg)" }, "easing": "linear" },
      { "at": 1, "element": 2, "props": { "transform": "rotate(360deg)" }, "easing": "linear" },
      { "at": 0, "element": 3, "props": { "opacity": 0 } },
      { "at": 0.12, "element": 3, "props": { "opacity": 0 } },
      { "at": 0.16, "element": 3, "props": { "opacity": 1 } },
      { "at": 0.6, "element": 3, "props": { "opacity": 0 } },
      { "at": 1, "element": 3, "props": { "opacity": 0 } },
      { "at": 0, "element": 4, "props": { "opacity": 0 } },
      { "at": 0.62, "element": 4, "props": { "opacity": 0 } },
      { "at": 0.66, "element": 4, "props": { "opacity": 1 } },
      { "at": 1, "element": 4, "props": { "opacity": 0.1 } }
    ]
  }
