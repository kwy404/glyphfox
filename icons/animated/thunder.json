{
  "categories": [
    "weather"
  ],
  "tags": [
    "storm",
    "lightning",
    "thunder",
    "weather"
  ],
  "animation": {
    "duration": 2000,
    "iterations": "infinite",
    "easing": "ease-in-out",
    "elements": [
      {
        "index": 1,
        "keyframes": [
          { "offset": 0, "opacity": 0 },
          { "offset": 0.08, "opacity": 1 },
          { "offset": 0.14, "opacity": 0.2 },
          { "offset": 0.2, "opacity": 1 },
          { "offset": 0.6, "opacity": 1 },
          { "offset": 0.7, "opacity": 0 },
          { "offset": 1, "opacity": 0 }
        ]
      }
    ]
  }
}
