{
  "categories": [
    "weather"
  ],
  "tags": [
    "storm",
    "lightning",
    "thunder",
    "weather"
  ],
  "animation": {
    "name": "thunder",
    "duration": 2000,
    "easing": "ease-in-out",
    "loop": true,
    "frames": [
      { "at": 0, "element": 1, "props": { "opacity": 0 } },
      { "at": 0.08, "element": 1, "props": { "opacity": 1 } },
      { "at": 0.14, "element": 1, "props": { "opacity": 0.2 } },
      { "at": 0.2, "element": 1, "props": { "opacity": 1 } },
      { "at": 0.6, "element": 1, "props": { "opacity": 1 } },
      { "at": 0.7, "element": 1, "props": { "opacity": 0 } },
      { "at": 1, "element": 1, "props": { "opacity": 0 } }
    ]
  }
}
