{
  "categories": [
    "communication"
  ],
  "tags": [
    "mail",
    "envelope",
    "open",
    "read",
    "letter"
  ],
  "animation": {
    "name": "envelope-open",
    "duration": 2400,
    "easing": "ease-in-out",
    "loop": true,
    "origin": [12, 9.5],
    "frames": [
      { "at": 0, "element": 1, "props": { "transform": "scale(1, 1)" } },
      { "at": 0.35, "element": 1, "props": { "transform": "scale(1, -1)" } },
      { "at": 0.75, "element": 1, "props": { "transform": "scale(1, -1)" } },
      { "at": 1, "element": 1, "props": { "transform": "scale(1, 1)" } }
    ]
  }
}
