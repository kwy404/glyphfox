{
  "categories": [
    "finance",
    "commerce"
  ],
  "tags": [
    "money",
    "purse",
    "payment",
    "cash"
  ],
  "animation": {
    "name": "open",
    "duration": 1000,
    "easing": "ease-in-out",
    "loop": false,
    "frames": [
      { "at": 0, "element": 1, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0.35, "element": 1, "props": { "transform": "translate(0px, -1px)" } },
      { "at": 0.6, "element": 1, "props": { "transform": "translate(0px, -1px)" } },
      { "at": 1, "element": 1, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0, "element": 2, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0.3, "element": 2, "props": { "transform": "translate(1px, 0px)" } },
      { "at": 0.65, "element": 2, "props": { "transform": "translate(1px, 0px)" } },
      { "at": 1, "element": 2, "props": { "transform": "translate(0px, 0px)" } }
    ]
  }
}
