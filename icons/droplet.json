{
  "categories": [
    "weather",
    "nature"
  ],
  "tags": [
    "water",
    "rain",
    "liquid",
    "drop",
    "humidity"
  ],
  "animation": {
    "name": "drip",
    "duration": 1000,
    "easing": "ease-in-out",
    "loop": false,
    "origin": [12, 21],
    "frames": [
      { "at": 0, "element": "all", "props": { "transform": "translate(0px, 0px) scale(1, 1)" }, "easing": "ease-in" },
      { "at": 0.35, "element": "all", "props": { "transform": "translate(0px, 1px) scale(0.96, 1.04)" } },
      { "at": 0.5, "element": "all", "props": { "transform": "translate(0px, 1px) scale(1.08, 0.92)" }, "easing": "ease-out" },
      { "at": 0.75, "element": "all", "props": { "transform": "translate(0px, 0px) scale(0.98, 1.02)" } },
      { "at": 1, "element": "all", "props": { "transform": "translate(0px, 0px) scale(1, 1)" } }
    ]
  }
}
