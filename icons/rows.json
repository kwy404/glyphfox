{
  "categories": [
    "navigation",
    "interface"
  ],
  "tags": [
    "layout",
    "split",
    "two rows",
    "stack"
  ],
  "animation": {
    "name": "slide",
    "duration": 900,
    "easing": "ease-in-out",
    "loop": false,
    "frames": [
      { "at": 0, "element": 1, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0.35, "element": 1, "props": { "transform": "translate(0px, -3px)" } },
      { "at": 0.7, "element": 1, "props": { "transform": "translate(0px, 2px)" } },
      { "at": 1, "element": 1, "props": { "transform": "translate(0px, 0px)" } }
    ]
  }
}
