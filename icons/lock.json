      { "at": 0.55, "element": 1, "props": { "transform": "translate(0px, -2px)" }, "easing": "ease-in" },
      { "at": 0.7, "element": 1, "props": { "transform": "translate(0px, 0.4px)" } },
      { "at": 0.8, "element": 1, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 1, "element": 1, "props": { "transform": "translate(0px, 0px)" } }
