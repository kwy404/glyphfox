      { "at": 0.15, "element": 1, "props": { "transform": "scale(1.15)" } },
      { "at": 0.3, "element": 1, "props": { "transform": "scale(1)" } },
      { "at": 0.45, "element": 1, "props": { "transform": "scale(1.09)" } },
      { "at": 0.7, "element": 1, "props": { "transform": "scale(1)" } },
      { "at": 1, "element": 1, "props": { "transform": "scale(1)" } },
      { "at": 0, "element": 2, "props": { "transform": "scale(1)" } },
      { "at": 0.15, "element": 2, "props": { "transform": "scale(1.15)" } },
      { "at": 0.3, "element": 2, "props": { "transform": "scale(1)" } },
      { "at": 0.45, "element": 2, "props": { "transform": "scale(1.09)" } },
      { "at": 0.7, "element": 2, "props": { "transform": "scale(1)" } },
      { "at": 1, "element": 2, "props": { "transform": "scale(1)" } }
    ]
  }
