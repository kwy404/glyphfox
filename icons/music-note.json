{
  "categories": [
    "music"
  ],
  "tags": [
    "note",
    "music",
    "melody",
    "song",
    "eighth note"
  ],
  "animation": {
    "name": "dance",
    "duration": 900,
    "easing": "ease-in-out",
    "loop": false,
    "origin": [10, 20],
    "frames": [
      { "at": 0, "element": "all", "props": { "transform": "translate(0px, 0px) rotate(0deg)" } },
      { "at": 0.3, "element": "all", "props": { "transform": "translate(0px, -1.5px) rotate(-8deg)" } },
      { "at": 0.6, "element": "all", "props": { "transform": "translate(0px, 0px) rotate(4deg)" } },
      { "at": 1, "element": "all", "props": { "transform": "translate(0px, 0px) rotate(0deg)" } }
    ]
  }
}
