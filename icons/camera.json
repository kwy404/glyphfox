  "animation": {
    "name": "focus",
    "duration": 700,
    "easing": "ease-in-out",
    "loop": false,
    "origin": [12, 13.5],
    "frames": [
      { "at": 0, "element": 1, "props": { "transform": "scale(1)" } },
      { "at": 0.3, "element": 1, "props": { "transform": "scale(0.7)" } },
      { "at": 0.6, "element": 1, "props": { "transform": "scale(1.08)" } },
      { "at": 1, "element": 1, "props": { "transform": "scale(1)" } }
    ]
  }
}
