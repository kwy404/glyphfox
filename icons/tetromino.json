{
  "categories": [
    "gaming"
  ],
  "tags": [
    "blocks",
    "puzzle",
    "falling blocks",
    "retro",
    "game"
  ],
  "animation": {
    "name": "rotate",
    "duration": 900,
    "easing": "ease-in-out",
    "loop": false,
    "frames": [
      { "at": 0, "element": "all", "props": { "transform": "rotate(0deg)" } },
      { "at": 0.4, "element": "all", "props": { "transform": "rotate(90deg)" } },
      { "at": 0.6, "element": "all", "props": { "transform": "rotate(90deg)" } },
      { "at": 1, "element": "all", "props": { "transform": "rotate(0deg)" } }
    ]
  }
}
