{
  "categories": [
    "arrows"
  ],
  "tags": [
    "clockwise",
    "rotate",
    "turn",
    "reload"
  ],
  "animation": {
    "name": "turn",
    "duration": 900,
    "easing": "ease-in-out",
    "loop": false,
    "frames": [
      { "at": 0, "element": "all", "props": { "transform": "rotate(0deg) scale(1)" } },
      { "at": 0.15, "element": "all", "props": { "transform": "rotate(30deg) scale(0.94)" } },
      { "at": 0.85, "element": "all", "props": { "transform": "rotate(330deg) scale(0.94)" } },
      { "at": 1, "element": "all", "props": { "transform": "rotate(360deg) scale(1)" } }
    ]
  }
}
