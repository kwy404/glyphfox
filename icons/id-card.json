      { "at": 0.15, "element": 4, "props": { "strokeDashoffset": 1 }, "easing": "ease-out" },
      { "at": 0.6, "element": 4, "props": { "strokeDashoffset": 0 } },
      { "at": 1, "element": 4, "props": { "strokeDashoffset": 0 } },
      { "at": 0, "element": 2, "props": { "strokeDashoffset": 1 } },
      { "at": 0.3, "element": 2, "props": { "strokeDashoffset": 1 }, "easing": "ease-out" },
      { "at": 0.75, "element": 2, "props": { "strokeDashoffset": 0 } },
      { "at": 1, "element": 2, "props": { "strokeDashoffset": 0 } }
