{
  "categories": [
    "commerce"
  ],
  "tags": [
    "clothes hanger",
    "wardrobe",
    "closet",
    "laundry",
    "fashion"
  ],
  "animation": {
    "name": "swing",
    "duration": 1100,
    "easing": "ease-in-out",
    "loop": false,
    "origin": [12, 2],
    "frames": [
      { "at": 0, "element": "all", "props": { "transform": "rotate(0deg)" } },
      { "at": 0.15, "element": "all", "props": { "transform": "rotate(6deg)" } },
      { "at": 0.32, "element": "all", "props": { "transform": "rotate(-4.5deg)" } },
      { "at": 0.5, "element": "all", "props": { "transform": "rotate(2.7deg)" } },
      { "at": 0.68, "element": "all", "props": { "transform": "rotate(-1.5deg)" } },
      { "at": 0.84, "element": "all", "props": { "transform": "rotate(0.6deg)" } },
      { "at": 1, "element": "all", "props": { "transform": "rotate(0deg)" } }
    ]
  }
}
