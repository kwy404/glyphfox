{
  "categories": [
    "weather"
  ],
  "tags": [
    "night",
    "partly cloudy",
    "forecast"
  ],
  "animation": {
    "name": "drift",
    "duration": 1400,
    "easing": "ease-in-out",
    "loop": false,
    "origin": [8, 8.5],
    "frames": [
      { "at": 0, "element": 0, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0.4, "element": 0, "props": { "transform": "translate(-1px, 0px)" } },
      { "at": 0.75, "element": 0, "props": { "transform": "translate(0.5px, 0px)" } },
      { "at": 1, "element": 0, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0, "element": 1, "props": { "transform": "rotate(0deg)" } },
      { "at": 0.4, "element": 1, "props": { "transform": "rotate(-8deg)" } },
      { "at": 0.75, "element": 1, "props": { "transform": "rotate(5deg)" } },
      { "at": 1, "element": 1, "props": { "transform": "rotate(0deg)" } }
    ]
  }
}
