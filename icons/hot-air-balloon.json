{
  "categories": [
    "travel"
  ],
  "tags": [
    "hot air balloon",
    "flight",
    "adventure",
    "sky",
    "festival"
  ],
  "animation": {
    "name": "float",
    "duration": 1400,
    "easing": "ease-in-out",
    "loop": false,
    "frames": [
      { "at": 0, "element": "all", "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0.5, "element": "all", "props": { "transform": "translate(0px, -1px)" } },
      { "at": 1, "element": "all", "props": { "transform": "translate(0px, 0px)" } }
    ]
  }
}
