{
  "categories": [
    "finance"
  ],
  "tags": [
    "money",
    "cash",
    "bill",
    "payment",
    "currency"
  ],
  "animation": {
    "name": "flip",
    "duration": 1000,
    "easing": "ease-in-out",
    "loop": false,
    "frames": [
      { "at": 0, "element": "all", "props": { "transform": "scale(1, 1)" } },
      { "at": 0.5, "element": "all", "props": { "transform": "scale(1, -1)" } },
      { "at": 1, "element": "all", "props": { "transform": "scale(1, 1)" } }
    ]
  }
}
