{
  "categories": [
    "maps",
    "nature"
  ],
  "tags": [
    "wind",
    "mill",
    "farm",
    "energy",
    "countryside"
  ],
  "animation": {
    "name": "turn",
    "duration": 1000,
    "easing": "ease-in-out",
    "loop": false,
    "origin": [12, 9],
    "frames": [
      { "at": 0, "element": 0, "props": { "transform": "rotate(0deg)" } },
      { "at": 1, "element": 0, "props": { "transform": "rotate(90deg)" } },
      { "at": 0, "element": 1, "props": { "transform": "rotate(0deg)" } },
      { "at": 1, "element": 1, "props": { "transform": "rotate(90deg)" } }
    ]
  }
}
