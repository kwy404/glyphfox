{
  "categories": [
    "files",
    "media"
  ],
  "tags": [
    "picture",
    "photo",
    "image",
    "graphic"
  ],
  "animation": {
    "name": "pop",
    "duration": 600,
    "easing": "ease-in-out",
    "loop": false,
    "origin": [10, 10],
    "frames": [
      { "at": 0, "element": 1, "props": { "transform": "scale(1)" } },
      { "at": 0.3, "element": 1, "props": { "transform": "scale(0.5)" } },
      { "at": 0.6, "element": 1, "props": { "transform": "scale(1.5)" } },
      { "at": 1, "element": 1, "props": { "transform": "scale(1)" } }
    ]
  }
}
