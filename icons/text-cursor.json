{
  "categories": [
    "text"
  ],
  "tags": [
    "caret",
    "input",
    "typing",
    "edit",
    "ibeam"
  ],
  "animation": {
    "name": "blink",
    "duration": 1000,
    "easing": "ease-in-out",
    "loop": true,
    "frames": [
      { "at": 0, "element": "all", "props": { "opacity": 1 } },
      { "at": 0.45, "element": "all", "props": { "opacity": 1 } },
      { "at": 0.5, "element": "all", "props": { "opacity": 0 } },
      { "at": 0.95, "element": "all", "props": { "opacity": 0 } },
      { "at": 1, "element": "all", "props": { "opacity": 1 } }
    ]
  }
}
