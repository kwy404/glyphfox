{
  "categories": [
    "travel"
  ],
  "tags": [
    "ferris wheel",
    "fair",
    "amusement park",
    "ride"
  ],
  "animation": {
    "name": "turn",
    "duration": 1400,
    "easing": "ease-in-out",
    "loop": false,
    "origin": [12, 10],
    "frames": [
      { "at": 0, "element": 0, "props": { "transform": "rotate(0deg)" } },
      { "at": 1, "element": 0, "props": { "transform": "rotate(60deg)" } },
      { "at": 0, "element": 1, "props": { "transform": "rotate(0deg)" } },
      { "at": 1, "element": 1, "props": { "transform": "rotate(60deg)" } },
      { "at": 0, "element": 2, "props": { "transform": "rotate(0deg)" } },
      { "at": 1, "element": 2, "props": { "transform": "rotate(60deg)" } },
      { "at": 0, "element": 3, "props": { "transform": "rotate(0deg)" } },
      { "at": 1, "element": 3, "props": { "transform": "rotate(60deg)" } }
    ]
  }
}
