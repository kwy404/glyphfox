  "animation": {
    "name": "flicker",
    "duration": 1000,
    "easing": "ease-in-out",
    "loop": false,
    "origin": [12, 22],
    "frames": [
      { "at": 0, "element": "all", "props": { "transform": "scale(1, 1)" } },
      { "at": 0.25, "element": "all", "props": { "transform": "scale(0.95, 1.04)" } },
      { "at": 0.5, "element": "all", "props": { "transform": "scale(1.03, 0.96)" } },
      { "at": 0.75, "element": "all", "props": { "transform": "scale(0.97, 1.03)" } },
      { "at": 1, "element": "all", "props": { "transform": "scale(1, 1)" } }
    ]
  }
}
