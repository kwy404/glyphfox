{
  "categories": [
    "weather"
  ],
  "tags": [
    "temperature",
    "heat",
    "cold",
    "degrees"
  ],
  "animation": {
    "name": "stretch",
    "duration": 900,
    "easing": "ease-in-out",
    "loop": false,
    "origin": [12, 17],
    "frames": [
      { "at": 0, "element": 0, "props": { "transform": "scale(1, 1)" } },
      { "at": 0.35, "element": 0, "props": { "transform": "scale(1, 1.05)" } },
      { "at": 0.65, "element": 0, "props": { "transform": "scale(1, 0.98)" } },
      { "at": 1, "element": 0, "props": { "transform": "scale(1, 1)" } }
    ]
  }
}
