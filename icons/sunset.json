  ],
  "animation": {
    "name": "nudge",
    "duration": 700,
    "easing": "ease-in-out",
    "loop": false,
    "frames": [
      { "at": 0, "element": 6, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0.35, "element": 6, "props": { "transform": "translate(0px, 1.5px)" } },
      { "at": 0.65, "element": 6, "props": { "transform": "translate(0px, -0.22px)" } },
      { "at": 1, "element": 6, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0, "element": 7, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0.35, "element": 7, "props": { "transform": "translate(0px, 1.5px)" } },
      { "at": 0.65, "element": 7, "props": { "transform": "translate(0px, -0.22px)" } },
      { "at": 1, "element": 7, "props": { "transform": "translate(0px, 0px)" } }
    ]
  }
