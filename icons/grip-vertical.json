{
  "categories": [
    "interface"
  ],
  "tags": [
    "drag",
    "handle",
    "reorder",
    "move",
    "dots"
  ],
  "animation": {
    "name": "drag",
    "duration": 900,
    "easing": "ease-in-out",
    "loop": false,
    "frames": [
      { "at": 0, "element": "all", "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0.3, "element": "all", "props": { "transform": "translate(0px, -1px)" } },
      { "at": 0.6, "element": "all", "props": { "transform": "translate(0px, 1px)" } },
      { "at": 1, "element": "all", "props": { "transform": "translate(0px, 0px)" } }
    ]
  }
}
