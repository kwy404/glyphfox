{
  "categories": [
    "finance",
    "commerce"
  ],
  "tags": [
    "card",
    "payment",
    "bank",
    "purchase",
    "debit"
  ],
  "animation": {
    "name": "swipe",
    "duration": 900,
    "easing": "ease-in-out",
    "loop": false,
    "frames": [
      { "at": 0, "element": "all", "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0.3, "element": "all", "props": { "transform": "translate(0.8px, 0px)" } },
      { "at": 0.6, "element": "all", "props": { "transform": "translate(-0.8px, 0px)" } },
      { "at": 1, "element": "all", "props": { "transform": "translate(0px, 0px)" } }
    ]
  }
}
