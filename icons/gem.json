{
  "categories": [
    "symbols",
    "commerce"
  ],
  "tags": [
    "diamond",
    "jewel",
    "premium",
    "value",
    "crystal"
  ],
  "animation": {
    "name": "twinkle",
    "duration": 900,
    "easing": "ease-in-out",
    "loop": false,
    "frames": [
      { "at": 0, "element": "all", "props": { "transform": "rotate(0deg) scale(1)" } },
      { "at": 0.35, "element": "all", "props": { "transform": "rotate(-6deg) scale(1.06)" } },
      { "at": 0.7, "element": "all", "props": { "transform": "rotate(3deg) scale(0.98)" } },
      { "at": 1, "element": "all", "props": { "transform": "rotate(0deg) scale(1)" } }
    ]
  }
}
