{
  "categories": [
    "interface"
  ],
  "tags": [
    "pointer",
    "mouse",
    "select",
    "click",
    "arrow"
  ],
  "animation": {
    "name": "press",
    "duration": 500,
    "easing": "ease-in-out",
    "loop": false,
    "origin": [3.5, 3.5],
    "frames": [
      { "at": 0, "element": "all", "props": { "transform": "scale(1)" } },
      { "at": 0.3, "element": "all", "props": { "transform": "scale(0.85)" } },
      { "at": 0.65, "element": "all", "props": { "transform": "scale(1.05)" } },
      { "at": 1, "element": "all", "props": { "transform": "scale(1)" } }
    ]
  }
}
