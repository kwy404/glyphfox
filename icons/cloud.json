{
  "categories": [
    "weather",
    "data"
  ],
  "tags": [
    "sky",
    "storage",
    "overcast",
    "weather"
  ],
  "animation": {
    "name": "drift",
    "duration": 1400,
    "easing": "ease-in-out",
    "loop": false,
    "frames": [
      { "at": 0, "element": "all", "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0.4, "element": "all", "props": { "transform": "translate(1px, 0px)" } },
      { "at": 0.75, "element": "all", "props": { "transform": "translate(-0.6px, 0px)" } },
      { "at": 1, "element": "all", "props": { "transform": "translate(0px, 0px)" } }
    ]
  }
}
