      { "at": 0.55, "element": 0, "props": { "transform": "rotate(-2.52deg)" } },
      { "at": 0.75, "element": 0, "props": { "transform": "rotate(1.02deg)" } },
      { "at": 1, "element": 0, "props": { "transform": "rotate(0deg)" } },
      { "at": 0, "element": 1, "props": { "transform": "rotate(0deg)" } },
      { "at": 0.15, "element": 1, "props": { "transform": "rotate(-6deg)" } },
      { "at": 0.35, "element": 1, "props": { "transform": "rotate(4.02deg)" } },
