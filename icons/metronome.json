{
  "categories": [
    "music"
  ],
  "tags": [
    "metronome",
    "tempo",
    "rhythm",
    "beat",
    "practice"
  ],
  "animation": {
    "name": "tick",
    "duration": 1200,
    "easing": "ease-in-out",
    "loop": false,
    "origin": [12, 15],
    "frames": [
      { "at": 0, "element": 2, "props": { "transform": "rotate(0deg)" } },
      { "at": 0.25, "element": 2, "props": { "transform": "rotate(15deg)" } },
      { "at": 0.5, "element": 2, "props": { "transform": "rotate(0deg)" } },
      { "at": 0.75, "element": 2, "props": { "transform": "rotate(-15deg)" } },
      { "at": 1, "element": 2, "props": { "transform": "rotate(0deg)" } },
      { "at": 0, "element": 3, "props": { "transform": "rotate(0deg)" } },
      { "at": 0.25, "element": 3, "props": { "transform": "rotate(15deg)" } },
      { "at": 0.5, "element": 3, "props": { "transform": "rotate(0deg)" } },
      { "at": 0.75, "element": 3, "props": { "transform": "rotate(-15deg)" } },
      { "at": 1, "element": 3, "props": { "transform": "rotate(0deg)" } }
    ]
  }
}
