{
  "categories": [
    "security"
  ],
  "tags": [
    "password",
    "access",
    "login",
    "unlock",
    "secret"
  ],
  "animation": {
    "name": "turn",
    "duration": 1000,
    "easing": "ease-in-out",
    "loop": false,
    "origin": [7.5, 16.5],
    "frames": [
      { "at": 0, "element": "all", "props": { "transform": "rotate(0deg)" } },
      { "at": 0.3, "element": "all", "props": { "transform": "rotate(-12deg)" } },
      { "at": 0.6, "element": "all", "props": { "transform": "rotate(8deg)" } },
      { "at": 1, "element": "all", "props": { "transform": "rotate(0deg)" } }
    ]
  }
}
