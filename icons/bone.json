{
  "categories": [
    "animals"
  ],
  "tags": [
    "dog",
    "pet",
    "treat",
    "skeleton"
  ],
  "animation": {
    "name": "wiggle",
    "duration": 800,
    "easing": "ease-in-out",
    "loop": false,
    "frames": [
      { "at": 0, "element": "all", "props": { "transform": "rotate(0deg)" } },
      { "at": 0.12, "element": "all", "props": { "transform": "rotate(-10deg)" } },
      { "at": 0.27, "element": "all", "props": { "transform": "rotate(10deg)" } },
      { "at": 0.42, "element": "all", "props": { "transform": "rotate(-7deg)" } },
      { "at": 0.57, "element": "all", "props": { "transform": "rotate(5deg)" } },
      { "at": 0.72, "element": "all", "props": { "transform": "rotate(-2.5deg)" } },
      { "at": 0.86, "element": "all", "props": { "transform": "rotate(1deg)" } },
      { "at": 1, "element": "all", "props": { "transform": "rotate(0deg)" } }
    ]
  }
}
