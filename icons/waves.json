{
  "categories": [
    "nature"
  ],
  "tags": [
    "water",
    "sea",
    "ocean",
    "wave",
    "beach"
  ],
  "animation": {
    "name": "flow",
    "duration": 1400,
    "easing": "ease-in-out",
    "loop": false,
    "frames": [
      { "at": 0, "element": 0, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0.5, "element": 0, "props": { "transform": "translate(1px, 0px)" } },
      { "at": 1, "element": 0, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0, "element": 2, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0.5, "element": 2, "props": { "transform": "translate(1px, 0px)" } },
      { "at": 1, "element": 2, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0, "element": 1, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0.5, "element": 1, "props": { "transform": "translate(-1px, 0px)" } },
      { "at": 1, "element": 1, "props": { "transform": "translate(0px, 0px)" } }
    ]
  }
}
