{
  "categories": [
    "text"
  ],
  "tags": [
    "wrap",
    "text",
    "line break",
    "format"
  ],
  "animation": {
    "name": "draw",
    "duration": 1100,
    "easing": "ease-in-out",
    "loop": false,
    "frames": [
      { "at": 0, "element": 0, "props": { "strokeDashoffset": 1 }, "easing": "ease-out" },
      { "at": 0.4, "element": 0, "props": { "strokeDashoffset": 0 } },
      { "at": 1, "element": 0, "props": { "strokeDashoffset": 0 } },
      { "at": 0, "element": 1, "props": { "strokeDashoffset": 1 } },
      { "at": 0.15, "element": 1, "props": { "strokeDashoffset": 1 }, "easing": "ease-out" },
      { "at": 0.6, "element": 1, "props": { "strokeDashoffset": 0 } },
      { "at": 1, "element": 1, "props": { "strokeDashoffset": 0 } },
      { "at": 0, "element": 2, "props": { "strokeDashoffset": 1 } },
      { "at": 0.55, "element": 2, "props": { "strokeDashoffset": 1 }, "easing": "ease-out" },
      { "at": 0.75, "element": 2, "props": { "strokeDashoffset": 0 } },
      { "at": 1, "element": 2, "props": { "strokeDashoffset": 0 } },
      { "at": 0, "element": 3, "props": { "strokeDashoffset": 1 } },
      { "at": 0.6, "element": 3, "props": { "strokeDashoffset": 1 }, "easing": "ease-out" },
      { "at": 0.9, "element": 3, "props": { "strokeDashoffset": 0 } },
      { "at": 1, "element": 3, "props": { "strokeDashoffset": 0 } }
    ]
  }
}
