{
  "categories": [
    "development"
  ],
  "tags": [
    "version control",
    "merge",
    "combine",
    "join"
  ],
  "animation": {
    "name": "connect",
    "duration": 1000,
    "easing": "ease-in-out",
    "loop": false,
    "origin": [18, 14],
    "frames": [
      { "at": 0, "element": 4, "props": { "strokeDashoffset": 1 }, "easing": "ease-out" },
      { "at": 0.6, "element": 4, "props": { "strokeDashoffset": 0 } },
      { "at": 1, "element": 4, "props": { "strokeDashoffset": 0 } },
      { "at": 0, "element": 3, "props": { "transform": "scale(1)" } },
      { "at": 0.45, "element": 3, "props": { "transform": "scale(1)" } },
      { "at": 0.615, "element": 3, "props": { "transform": "scale(0.75)" } },
      { "at": 0.78, "element": 3, "props": { "transform": "scale(1.25)" } },
      { "at": 1, "element": 3, "props": { "transform": "scale(1)" } }
    ]
  }
}
