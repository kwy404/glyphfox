{
  "categories": [
    "sports"
  ],
  "tags": [
    "surfboard",
    "surf",
    "wave",
    "beach",
    "board"
  ],
  "animation": {
    "name": "ride",
    "duration": 1200,
    "easing": "ease-in-out",
    "loop": false,
    "frames": [
      { "at": 0, "element": "all", "props": { "transform": "rotate(0deg)" } },
      { "at": 0.3, "element": "all", "props": { "transform": "rotate(-8deg)" } },
      { "at": 0.65, "element": "all", "props": { "transform": "rotate(4.8deg)" } },
      { "at": 1, "element": "all", "props": { "transform": "rotate(0deg)" } }
    ]
  }
}
