{
  "categories": [
    "travel"
  ],
  "tags": [
    "sailboat",
    "sailing",
    "boat",
    "sea",
    "yacht"
  ],
  "animation": {
    "name": "rock",
    "duration": 1200,
    "easing": "ease-in-out",
    "loop": false,
    "origin": [12, 21],
    "frames": [
      { "at": 0, "element": "all", "props": { "transform": "rotate(0deg)" } },
      { "at": 0.3, "element": "all", "props": { "transform": "rotate(-5deg)" } },
      { "at": 0.65, "element": "all", "props": { "transform": "rotate(3deg)" } },
      { "at": 1, "element": "all", "props": { "transform": "rotate(0deg)" } }
    ]
  }
}
