{
  "categories": [
    "gaming"
  ],
  "tags": [
    "crystal ball",
    "magic",
    "fortune",
    "mystic"
  ],
  "animation": {
    "name": "glow",
    "duration": 1000,
    "easing": "ease-in-out",
    "loop": false,
    "origin": [14, 9],
    "frames": [
      { "at": 0, "element": 3, "props": { "transform": "rotate(0deg) scale(1)" } },
      { "at": 0.3, "element": 3, "props": { "transform": "rotate(25deg) scale(0.85)" } },
      { "at": 0.65, "element": 3, "props": { "transform": "rotate(-12.5deg) scale(1.1)" } },
      { "at": 1, "element": 3, "props": { "transform": "rotate(0deg) scale(1)" } },
      { "at": 0, "element": 2, "props": { "opacity": 1 } },
      { "at": 0.15, "element": 2, "props": { "opacity": 0.2 } },
      { "at": 0.3, "element": 2, "props": { "opacity": 1 } },
      { "at": 0.45, "element": 2, "props": { "opacity": 0.2 } },
      { "at": 0.6, "element": 2, "props": { "opacity": 1 } },
      { "at": 1, "element": 2, "props": { "opacity": 1 } }
    ]
  }
}
