{
  "categories": [
    "sports"
  ],
  "tags": [
    "kettlebell",
    "weight",
    "gym",
    "fitness",
    "workout"
  ],
  "animation": {
    "name": "swing",
    "duration": 1000,
    "easing": "ease-in-out",
    "loop": false,
    "origin": [12, 3],
    "frames": [
      { "at": 0, "element": "all", "props": { "transform": "rotate(0deg)" } },
      { "at": 0.15, "element": "all", "props": { "transform": "rotate(10deg)" } },
      { "at": 0.32, "element": "all", "props": { "transform": "rotate(-7.5deg)" } },
      { "at": 0.5, "element": "all", "props": { "transform": "rotate(4.5deg)" } },
      { "at": 0.68, "element": "all", "props": { "transform": "rotate(-2.5deg)" } },
      { "at": 0.84, "element": "all", "props": { "transform": "rotate(1deg)" } },
      { "at": 1, "element": "all", "props": { "transform": "rotate(0deg)" } }
    ]
  }
}
