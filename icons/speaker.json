{
  "categories": [
    "devices"
  ],
  "tags": [
    "audio",
    "sound",
    "music",
    "loudspeaker"
  ],
  "animation": {
    "name": "beat",
    "duration": 900,
    "easing": "ease-in-out",
    "loop": false,
    "origin": [12, 14.5],
    "frames": [
      { "at": 0, "element": 1, "props": { "transform": "scale(1)" } },
      { "at": 0.15, "element": 1, "props": { "transform": "scale(1.15)" } },
      { "at": 0.3, "element": 1, "props": { "transform": "scale(1)" } },
      { "at": 0.45, "element": 1, "props": { "transform": "scale(1.09)" } },
      { "at": 0.7, "element": 1, "props": { "transform": "scale(1)" } },
      { "at": 1, "element": 1, "props": { "transform": "scale(1)" } }
    ]
  }
}
