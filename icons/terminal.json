  ],
  "tags": [
    "console",
    "shell",
    "command line",
    "prompt"
  ],
  "animation": {
    "name": "prompt",
    "duration": 1000,
    "easing": "ease-in-out",
    "loop": false,
    "frames": [
      { "at": 0, "element": 1, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0.35, "element": 1, "props": { "transform": "translate(1px, 0px)" } },
      { "at": 0.65, "element": 1, "props": { "transform": "translate(-0.15px, 0px)" } },
      { "at": 1, "element": 1, "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0, "element": 2, "props": { "opacity": 1 } },
      { "at": 0.45, "element": 2, "props": { "opacity": 1 } },
      { "at": 0.5, "element": 2, "props": { "opacity": 0 } },
      { "at": 0.95, "element": 2, "props": { "opacity": 0 } },
      { "at": 1, "element": 2, "props": { "opacity": 1 } }
    ]
  }
}
