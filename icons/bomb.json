{
  "categories": [
    "gaming"
  ],
  "tags": [
    "explosive",
    "boom",
    "danger",
    "cartoon"
  ],
  "animation": {
    "name": "fuse",
    "duration": 900,
    "easing": "ease-in-out",
    "loop": false,
    "origin": [20.4, 3.6],
    "frames": [
      { "at": 0, "element": 3, "props": { "transform": "rotate(0deg) scale(1)" } },
      { "at": 0.3, "element": 3, "props": { "transform": "rotate(30deg) scale(0.85)" } },
      { "at": 0.65, "element": 3, "props": { "transform": "rotate(-15deg) scale(1.1)" } },
      { "at": 1, "element": 3, "props": { "transform": "rotate(0deg) scale(1)" } },
      { "at": 0, "element": "all", "props": { "transform": "translate(0px, 0px)" } },
      { "at": 0.12, "element": "all", "props": { "transform": "translate(-0.6px, 0px)" } },
      { "at": 0.27, "element": "all", "props": { "transform": "translate(0.6px, 0px)" } },
      { "at": 0.42, "element": "all", "props": { "transform": "translate(-0.42px, 0px)" } },
      { "at": 0.57, "element": "all", "props": { "transform": "translate(0.3px, 0px)" } },
      { "at": 0.72, "element": "all", "props": { "transform": "translate(-0.15px, 0px)" } },
      { "at": 0.86, "element": "all", "props": { "transform": "translate(0.06px, 0px)" } },
      { "at": 1, "element": "all", "props": { "transform": "translate(0px, 0px)" } }
    ]
  }
}
