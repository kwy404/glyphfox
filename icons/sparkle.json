{
  "categories": [
    "symbols"
  ],
  "tags": [
    "star",
    "shine",
    "magic",
    "new",
    "twinkle"
  ],
  "animation": {
    "name": "twinkle",
    "duration": 900,
    "easing": "ease-in-out",
    "loop": false,
    "frames": [
      { "at": 0, "element": "all", "props": { "transform": "rotate(0deg) scale(1)" } },
      { "at": 0.4, "element": "all", "props": { "transform": "rotate(45deg) scale(0.8)" } },
      { "at": 0.75, "element": "all", "props": { "transform": "rotate(90deg) scale(1.08)" } },
      { "at": 1, "element": "all", "props": { "transform": "rotate(90deg) scale(1)" } }
    ]
  }
}
