{
  "categories": [
    "finance"
  ],
  "tags": [
    "money",
    "currency",
    "gbp",
    "sterling",
    "price"
  ],
  "animation": {
    "name": "draw",
    "duration": 1000,
    "easing": "ease-in-out",
    "loop": false,
    "frames": [
      { "at": 0, "element": 0, "props": { "strokeDashoffset": 1 }, "easing": "ease-out" },
      { "at": 0.6, "element": 0, "props": { "strokeDashoffset": 0 } },
      { "at": 1, "element": 0, "props": { "strokeDashoffset": 0 } },
      { "at": 0, "element": 1, "props": { "strokeDashoffset": 1 } },
      { "at": 0.45, "element": 1, "props": { "strokeDashoffset": 1 }, "easing": "ease-out" },
      { "at": 0.8, "element": 1, "props": { "strokeDashoffset": 0 } },
      { "at": 1, "element": 1, "props": { "strokeDashoffset": 0 } }
    ]
  }
}
